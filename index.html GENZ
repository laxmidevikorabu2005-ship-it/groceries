<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NOIR — Gen Z Restaurant</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Background Glow -->
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>

    <!-- NAVBAR -->
    <header class="navbar">

        <div class="logo">
            <span>NOIR</span>
            <small>eat different.</small>
        </div>

        <nav>
            <a href="#home">Home</a>
            <a href="#menu">Menu</a>
            <a href="#vibes">Vibes</a>
            <a href="#about">About</a>
        </nav>

        <a href="#menu" class="nav-btn">
            Order Now <span>↗</span>
        </a>

    </header>


    <!-- HERO -->
    <main id="home">

        <section class="hero">

            <div class="hero-content">

                <div class="tag">
                    🔥 OPEN TILL 2AM
                </div>

                <h1>
                    GOOD FOOD.
                    <br>
                    <span>BAD DECISIONS.</span>
                </h1>

                <p>
                    Late-night cravings, insane flavors,
                    and food worth posting about.
                </p>

                <div class="hero-buttons">

                    <a href="#menu" class="primary-btn">
                        Explore Menu
                        <span>→</span>
                    </a>

                    <a href="#about" class="secondary-btn">
                        Our Story
                    </a>

                </div>

                <div class="hero-stats">

                    <div>
                        <strong>4.9★</strong>
                        <span>Google Rating</span>
                    </div>

                    <div>
                        <strong>50K+</strong>
                        <span>Happy Foodies</span>
                    </div>

                    <div>
                        <strong>24/7</strong>
                        <span>Cravings</span>
                    </div>

                </div>

            </div>


            <!-- HERO FOOD -->
            <div class="hero-image">

                <div class="circle"></div>

                <div class="food-card">

                    <img
                        src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=900&q=85"
                        alt="Pizza"
                    >

                    <div class="floating-rating">
                        ⭐ 4.9
                    </div>

                    <div class="floating-price">
                        ₹299
                    </div>

                </div>

                <div class="floating-text text-1">
                    EXTRA CHEESE 🧀
                </div>

                <div class="floating-text text-2">
                    100% VIBES ✨
                </div>

            </div>

        </section>


        <!-- MARQUEE -->
        <section class="marquee">

            <div class="marquee-track">
                <span>BURGERS 🍔</span>
                <span>•</span>
                <span>PIZZA 🍕</span>
                <span>•</span>
                <span>FRIES 🍟</span>
                <span>•</span>
                <span>MILKSHAKES 🥤</span>
                <span>•</span>
                <span>DESSERTS 🍩</span>
                <span>•</span>
                <span>GOOD VIBES ✨</span>
            </div>

        </section>


        <!-- MENU -->
        <section class="menu-section" id="menu">

            <div class="section-heading">

                <div>
                    <span class="eyebrow">WHAT'S HOT</span>

                    <h2>
                        Trending
                        <span>Right Now.</span>
                    </h2>
                </div>

                <p>
                    The stuff everyone's ordering.
                    Don't say we didn't warn you.
                </p>

            </div>


            <div class="menu-grid">

                <!-- CARD 1 -->
                <article class="menu-card">

                    <div class="menu-image">

                        <img
                            src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=800&q=85"
                            alt="Burger"
                        >

                        <span class="badge">BESTSELLER</span>

                    </div>

                    <div class="menu-info">

                        <div>
                            <h3>NOIR Smash</h3>
                            <p>Double beef · cheddar · secret sauce</p>
                        </div>

                        <strong>₹349</strong>

                    </div>

                    <button class="add-btn">
                        + Add
                    </button>

                </article>


                <!-- CARD 2 -->
                <article class="menu-card">

                    <div class="menu-image">

                        <img
                            src="https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=800&q=85"
                            alt="Pizza"
                        >

                        <span class="badge pink">HOT 🔥</span>

                    </div>

                    <div class="menu-info">

                        <div>
                            <h3>Midnight Pizza</h3>
                            <p>Spicy pepperoni · mozzarella · chili oil</p>
                        </div>

                        <strong>₹499</strong>

                    </div>

                    <button class="add-btn">
                        + Add
                    </button>

                </article>


                <!-- CARD 3 -->
                <article class="menu-card">

                    <div class="menu-image">

                        <img
                            src="https://images.unsplash.com/photo-1573080496219-bb080dd4f877?auto=format&fit=crop&w=800&q=85"
                            alt="French Fries"
                        >

                        <span class="badge purple">NEW</span>

                    </div>

                    <div class="menu-info">

                        <div>
                            <h3>Loaded Fries</h3>
                            <p>Cheese · jalapeño · crispy chicken</p>
                        </div>

                        <strong>₹249</strong>

                    </div>

                    <button class="add-btn">
                        + Add
                    </button>

                </article>

            </div>

        </section>


        <!-- VIBES -->
        <section class="vibes" id="vibes">

            <div class="vibes-image">

                <img
                    src="https://images.unsplash.com/photo-1515003197210-e0cd71810b5f?auto=format&fit=crop&w=1200&q=85"
                    alt="Restaurant interior"
                >

                <div class="image-label">
                    📍 VISAKHAPATNAM
                </div>

            </div>


            <div class="vibes-content">

                <span class="eyebrow">THE VIBE</span>

                <h2>
                    Not just
                    <span>a restaurant.</span>
                </h2>

                <p>
                    Come for the food. Stay because the playlist
                    is actually good.
                </p>

                <p>
                    NOIR is where late-night food cravings,
                    good music, friends and unforgettable
                    moments collide.
                </p>

                <a href="#about" class="primary-btn">
                    Get to know us →
                </a>

            </div>

        </section>


        <!-- CTA -->
        <section class="cta" id="about">

            <span>YOUR TABLE IS WAITING.</span>

            <h2>
                READY TO
                <br>
                <em>FEAST?</em>
            </h2>

            <a href="#menu" class="cta-btn">
                Book / Order Now →
            </a>

        </section>


        <!-- FOOTER -->
        <footer>

            <div class="footer-brand">

                <h2>NOIR</h2>

                <p>
                    Food for the main characters.
                </p>

            </div>


            <div class="footer-links">

                <div>
                    <h4>Explore</h4>
                    <a href="#home">Home</a>
                    <a href="#menu">Menu</a>
                    <a href="#vibes">Vibes</a>
                </div>

                <div>
                    <h4>Visit</h4>
                    <p>Beach Road</p>
                    <p>Visakhapatnam</p>
                    <p>Andhra Pradesh</p>
                </div>

                <div>
                    <h4>Hours</h4>
                    <p>Mon – Thu: 11AM – 12AM</p>
                    <p>Fri – Sun: 11AM – 2AM</p>
                </div>

            </div>


            <div class="copyright">
                © 2026 NOIR. Made for food lovers.
            </div>

        </footer>

    </main>

</body>
</html>